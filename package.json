{
	"name": "blitz-knoellchen",
	"description": "Progressive Web App zur Meldung von Falschparkern an die Bußgeldstelle Köln per E-Mail.",
	"private": true,
	"license": "UNLICENSED",
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": "24.x",
		"npm": ">=11.17.0"
	},
	"author": "Alex F",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AlexF090/blitz-knoellchen.git"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"screenshots": "node scripts/generate-screenshots.mjs",
		"og-image": "node scripts/generate-og-image.mjs"
	},
	"lint-staged": {
		"*.{js,ts,svelte,json,md,css}": "prettier --write",
		"*.{js,ts,svelte}": [
			"eslint --fix",
			"npm run check"
		]
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-vercel": "7.0.1",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.19.2",
		"@vite-pwa/assets-generator": "1.0.4",
		"@vitest/browser-playwright": "5.0.5",
		"@vitest/coverage-istanbul": "5.0.5",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"playwright": "1.64.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "3.1.0"
	},
	"dependencies": {
		"@fontsource/archivo": "5.3.0",
		"@lucide/svelte": "1.55.0",
		"@vercel/analytics": "2.0.1",
		"@vite-pwa/sveltekit": "1.1.0",
		"exifreader": "4.49.0",
		"heic-to": "1.6.6",
		"idb": "8.0.4",
		"piexifjs": "1.0.6"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"exifreader@4.49.0": true,
		"fsevents@2.3.3": true
	}
}
