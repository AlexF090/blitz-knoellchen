{
	// Basis erzeugt `svelte-kit sync` in node_modules/$app/tsconfig.json (u. a. Modulauflösung,
	// `allowImportingTsExtensions` für die `#lib`-Imports mit Dateiendung).
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"]
}
