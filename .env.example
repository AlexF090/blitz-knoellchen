# Muss eine in Brevo domain-authentifizierte (SPF/DKIM) Adresse einer selbst besessenen Domain
# sein — keine Adresse bei Apple/Google/Microsoft/GMX/freenet o.ä., sonst scheitert die
# DMARC-Alignment-Prüfung beim Empfänger (siehe ADR "E-Mail-Versand über Brevo" in docs/architektur.md).
BREVO_API_KEY=
EMAIL_FROM=
# Test-/Entwickler-Adresse für den Demo-Modus (s. ADR "Demo/Live-Modus-Auswahl" in docs/architektur.md).
RECIPIENT_EMAIL_DEMO=
# Offizielle Bußgeldstelle-Köln-Adresse für Fremdanzeigen im Live-Modus:
# bussgeldstelle@stadt-koeln.de (Quelle: stadt-koeln.de, Stand 2026-09-13).
RECIPIENT_EMAIL_LIVE=
LOCATIONIQ_API_KEY=
# Optional, nur für E2E-Tests: überschreibt die Brevo-Basis-URL, damit der Server-Endpunkt
# api/send/+server.ts real ausgeführt wird, aber gegen einen lokalen Mock statt der echten
# Brevo-API sendet (s. e2e/mocks/brevo-mock-server.mjs, playwright.config.ts). Leer/unset = echte
# Brevo-API.
BREVO_API_URL=
# Optional, nur für E2E-Tests: hebt das Rate-Limit von /api/send (Standard 20 pro Stunde und IP)
# an, weil alle E2E-Tests von derselben IP aus senden. Leer/unset = Standard.
SEND_LIMIT_PER_HOUR=
