# ---------- VERSIONEN ----------
# Exakte Versionen in package.json speichern — reproduzierbare Installs ohne
# stille Minor-Sprünge zwischen zwei `npm i`-Läufen.
save-exact=true
save-prefix=""

# Install abbrechen, wenn Node/npm nicht zum "engines"-Feld passen, statt still
# auf einer nicht unterstützten Runtime zu bauen. Zielversion: siehe .nvmrc.
# engines.node ist bewusst auf 24.x gepinnt, nicht >=24: Vercel wählt die Build-Version
# aus engines und würde sonst mit dem nächsten Node-Major automatisch wechseln.
engine-strict=true

# ---------- SICHERHEIT ----------
# Registry-Verbindungen nur über TLS.
strict-ssl=true

# Bewusst NICHT gesetzt: ignore-scripts=true. Dieses Projekt regelt
# Install-Skripte über das "allowScripts"-Feld in package.json: eine
# versionsgenaue Allowlist (esbuild, exifreader, fsevents). Ohne
# strict-allow-scripts führt npm 11 nicht gelistete Skripte trotzdem aus und
# gibt nur einen Hinweis aus; erst mit der Option bricht der Install ab.
# Mindestens npm 11.17.0 (engines): die erste Version mit dieser Option. Höher
# geht nicht, weil Vercels Node-24-Image npm 11.17.0 mitbringt und engine-strict
# den Install sonst abbricht. fsevents steht bewusst in der Allowlist, obwohl es
# auf Linux nie installiert wird: npm vor 11.18 meldet sonst auch dort
# ESTRICTALLOWSCRIPTS.
strict-allow-scripts=true

# ---------- AUSGABE ----------
fund=false
update-notifier=false
# Fortschrittsbalken aus — weniger Rauschen, besonders in CI-Logs.
progress=false
